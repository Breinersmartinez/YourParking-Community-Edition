
#  YourParking - Variables de entorno para docker compose
#  Copia este archivo a .env y completa los valores:
#     cp .env.example .env


# ------------------------- PostgreSQL -------------------------
POSTGRES_DB=parking_db
POSTGRES_USER=parking_user
POSTGRES_PASSWORD=cambia_esta_password

# --------------------------- Backend --------------------------
# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
TOKEN_JWT=cambia_este_secreto_jwt_minimo_32_caracteres

# Credenciales SMTP (Gmail: usa una App Password, no tu contraseña)
USER_NAME_MAIL=correo@gmail.com
APP_PASSWORD=app_password_de_gmail

# Token de acceso de Mercado Pago
ACCESS_TOKEN=tu_token_de_mercadopago

# --------------------------- Grafana --------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
