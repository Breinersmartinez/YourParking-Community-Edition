# =====================================================================
# YourParking — Variables de entorno del docker-compose (todas opcionales)
#
# Copia este archivo a ".env" en la raíz del repo y ajusta los valores.
# Sin ".env", el stack levanta en local con los valores por defecto:
#   PostgreSQL local con el esquema de db/parking_management.sql.
# =====================================================================

# --- Base de datos local (solo si usas la PostgreSQL del compose) ---
POSTGRES_DB=parking_management
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking123
POSTGRES_PORT=5432

# --- Backend ---
# Descomenta y completa para apuntar a una BD externa (p. ej. Neon):
#   URL_DB=jdbc:postgresql://tu-host:5432/tu-bd?sslmode=require
#   USER_NAME=tu_usuario
#   PASSWORD_DB=tu_password
# Clave secreta de los JWT (¡siempre cámbiala fuera de desarrollo!).
TOKEN_JWT=solo-desarrollo-token-jwt-reemplazar-por-variable-TOKEN_JWT
# Credenciales SMTP de Gmail (opcionales, para enviar correos).
USER_NAME_MAIL=
APP_PASSWORD=
# Access token de Mercado Pago (opcional).
ACCESS_TOKEN=
BACKEND_PORT=8080

# --- Frontend ---
# URL que el navegador usará para llamar a la API (build-arg API_URL de Angular).
API_URL=http://localhost:8080
FRONTEND_PORT=3000

# --- Observabilidad ---
GRAFANA_PORT=3001
#PROMETHEUS_PORT=9090