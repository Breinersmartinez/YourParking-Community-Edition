{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/parking-frontend/browser",
  "framework": "angular",
  "installCommand": "npm ci",
  "buildCommand": "sed -i \"s|apiUrl: '.*'|apiUrl: '${API_URL:-http://localhost:8080}'|\" src/environments/environment.prod.ts && npm run build:prod",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
